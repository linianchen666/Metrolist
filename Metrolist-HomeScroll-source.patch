+internal data class WatchLibraryState(
+    val playlists: List<PlaylistItem> = emptyList(),
+    val loading: Boolean = false,
+    val failed: Boolean = false,
+    val loaded: Boolean = false,
+    val selected: PlaylistItem? = null,
+    val songs: List<MediaMetadata> = emptyList(),
+    val songsLoading: Boolean = false,
+    val songsFailed: Boolean = false,
+)
+
+internal fun watchDownloadCandidates(songs: List<MediaMetadata>, states: Map<String, Int>): List<MediaMetadata> =
+    songs.distinctBy { it.id }.filter {
+        states[it.id] == null || states[it.id] == Download.STATE_FAILED || states[it.id] == Download.STATE_STOPPED
+    }
+
+internal class WatchLibraryViewModel(
+    private val loadPlaylists: suspend () -> Result<List<PlaylistItem>> = {
+        YouTube.library("FEmusic_liked_playlists").completed().map { page ->
+            page.items.filterIsInstance<PlaylistItem>().filterNot { it.id == "LM" || it.id == "SE" }
+        }
+    },
+    private val loadSongs: suspend (String) -> Result<List<MediaMetadata>> = { id ->
+        if (id == "LM") {
+            YouTube.library("FEmusic_liked_videos").completed().map { page ->
+                page.items.filterIsInstance<SongItem>().map { it.toMediaMetadata() }
+            }
+        } else {
+            YouTube.playlist(id).completed().map { page -> page.songs.map { it.toMediaMetadata() } }
+        }
+    },
+) : ViewModel() {
+    var state by mutableStateOf(WatchLibraryState())
+        private set
+    private var libraryRequest: Job? = null
+    private var songsRequest: Job? = null
+
+    fun reset() {
+        libraryRequest?.cancel()
+        songsRequest?.cancel()
+        state = WatchLibraryState()
+    }
+
+    fun refresh() {
+        if (state.loading) return
+        state = state.copy(loading = true, failed = false)
+        libraryRequest = viewModelScope.launch {
+            val result = loadPlaylists()
+            currentCoroutineContext().ensureActive()
+            result.fold(
+                onSuccess = { state = state.copy(playlists = it.distinctBy { p -> p.id }, loading = false, loaded = true) },
+                onFailure = {
+                    if (it is CancellationException) throw it
+                    state = state.copy(loading = false, failed = true)
+                },
+            )
+        }
+    }
+
+    fun open(playlist: PlaylistItem) {
+        songsRequest?.cancel()
+        state = state.copy(selected = playlist, songs = emptyList(), songsLoading = true, songsFailed = false)
+        songsRequest = viewModelScope.launch {
+            val result = loadSongs(playlist.id)
+            currentCoroutineContext().ensureActive()
+            result.fold(
+                onSuccess = { state = state.copy(songs = it.distinctBy { song -> song.id }, songsLoading = false) },
+                onFailure = {
+                    if (it is CancellationException) throw it
+                    state = state.copy(songsLoading = false, songsFailed = true)
+                },
+            )
+        }
+    }
+}
