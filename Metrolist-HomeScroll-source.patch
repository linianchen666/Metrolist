+                    AsyncImage(metadata.thumbnailUrl, null, Modifier.padding(start = 6.dp).size(28.dp).clip(RoundedCornerShape(6.dp)), contentScale = ContentScale.Crop)
+                    Text(metadata.title, Modifier.weight(1f).clickable { page = "player" }.padding(6.dp),
+                        maxLines = 1, overflow = TextOverflow.Ellipsis, style = MaterialTheme.typography.labelSmall)
+                    IconButton(onClick = onTogglePlayback, enabled = ready, modifier = Modifier.size(36.dp)) {
+                        Icon(painterResource(if (playing) R.drawable.pause else R.drawable.play),
+                            stringResource(if (playing) R.string.pause else R.string.play), Modifier.size(22.dp))
+                    }
