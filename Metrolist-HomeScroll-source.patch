+                                    Text(playlist.title, maxLines = 2, overflow = TextOverflow.Ellipsis, style = MaterialTheme.typography.bodyMedium)
+                                    playlist.songCountText?.let { Text(it, style = MaterialTheme.typography.bodySmall) }
+                                }
+                            }
+                        }
+                        if (accountLibrary.loading) {
+                            item { CircularProgressIndicator(Modifier.size(24.dp)) }
+                        } else {
+                            if (accountLibrary.failed) {
+                                item { Text(stringResource(R.string.watch_playlist_load_failed), color = MaterialTheme.colorScheme.error) }
+                            } else if (accountLibrary.loaded && accountLibrary.playlists.isEmpty()) {
+                                item { Text(stringResource(R.string.watch_no_saved_playlists), style = MaterialTheme.typography.bodySmall) }
+                            }
+                            item { WatchButton(stringResource(if (accountLibrary.failed) R.string.retry else R.string.watch_refresh_recommendations), onClick = onLoadPlaylists) }
