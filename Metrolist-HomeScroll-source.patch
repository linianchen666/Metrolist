+@Composable
+fun WatchApp(playerConnection: PlayerConnection?, database: MusicDatabase, downloadUtil: DownloadUtil) {
+    if (playerConnection == null) {
+        Box(Modifier.fillMaxSize().background(Color.Black), contentAlignment = Alignment.Center) {
+            Text(stringResource(R.string.watch_connecting), color = Color.White)
+        }
+        return
+    }
+    val metadata by playerConnection.mediaMetadata.collectAsStateWithLifecycle()
+    val playing by playerConnection.isPlaying.collectAsStateWithLifecycle()
+    val ready by playerConnection.service.isPlayerReady.collectAsStateWithLifecycle()
+    val canNext by playerConnection.canSkipNext.collectAsStateWithLifecycle()
+    val canPrevious by playerConnection.canSkipPrevious.collectAsStateWithLifecycle()
+    val playbackError by playerConnection.error.collectAsStateWithLifecycle()
+    val playbackState by playerConnection.playbackState.collectAsStateWithLifecycle()
+    val currentSong by playerConnection.currentSong.collectAsStateWithLifecycle()
+    val downloadRecords by downloadUtil.downloads.collectAsStateWithLifecycle()
+    val library by remember(database) { database.songs(SongSortType.NAME, false) }
+        .collectAsStateWithLifecycle(initialValue = emptyList())
+    val downloads by remember(database) { database.downloadedSongs(SongSortType.NAME, false) }
+        .collectAsStateWithLifecycle(initialValue = emptyList())
+    val search: WatchSearchViewModel = viewModel()
+    val recommendations: WatchRecommendationsViewModel = viewModel()
+    val account: WatchAccountViewModel = viewModel()
+    val accountLibrary: WatchLibraryViewModel = viewModel()
+    val accountName by rememberPreference(AccountNameKey, "")
+    val cookie by rememberPreference(InnerTubeCookieKey, "")
+    val quickPicksTitle = stringResource(R.string.quick_picks)
+    LaunchedEffect(quickPicksTitle, cookie) {
+        recommendations.reset()
+        recommendations.refresh(quickPicksTitle)
+        accountLibrary.reset()
+    }
+    WatchContent(
+        metadata = metadata,
+        playing = playing,
+        ready = ready,
+        canNext = canNext,
+        canPrevious = canPrevious,
+        buffering = playbackState == Player.STATE_BUFFERING,
+        playbackError = playbackError?.localizedMessage,
+        inLibrary = currentSong?.song?.inLibrary != null,
+        downloadState = downloadRecords[metadata?.id]?.state,
+        library = library.map { it.toMediaMetadata() },
+        downloads = downloads.map { it.toMediaMetadata() },
+        search = search.state,
+        recommendations = recommendations.state,
+        onRefreshRecommendations = { recommendations.refresh(quickPicksTitle) },
+        accountName = accountName,
+        signedIn = cookie.isNotBlank(),
+        accountBusy = account.busy,
+        accountFailed = account.failed,
+        onSignIn = { token, done ->
+            account.signIn(token) {
+                recommendations.reset()
+                recommendations.refresh(quickPicksTitle)
+                done()
+            }
+        },
+        onImportFile = { done -> account.importLoginFile(done) },
+        onSignOut = {
+            account.signOut {
+                recommendations.reset()
+                recommendations.refresh(quickPicksTitle)
+            }
+        },
+        onSearch = search::search,
+        onLoadMore = search::loadMore,
+        onRetry = search::retry,
+        onPlay = { songs, index ->
+            playerConnection.playQueue(ListQueue(items = songs.map { it.toMediaItem() }, startIndex = index))
+        },
+        onTogglePlayback = playerConnection::togglePlayPause,
+        onPrevious = playerConnection::seekToPrevious,
+        onNext = playerConnection::seekToNext,
+        onSave = playerConnection::toggleLibrary,
+        onDownload = { metadata?.let(downloadUtil::download) },
+        accountLibrary = accountLibrary.state,
+        downloadStates = downloadRecords.mapValues { it.value.state },
+        onLoadPlaylists = accountLibrary::refresh,
+        onOpenPlaylist = accountLibrary::open,
+        onDownloadSongs = { songs -> songs.forEach(downloadUtil::download) },
+    )
+}
