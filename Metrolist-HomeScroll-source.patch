+package com.metrolist.music.ui.screens.watch
+
+import java.io.File
+import org.junit.Assert.*
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+
+class WatchLoginFileTest {
+    @get:Rule val folder = TemporaryFolder()
+    private val token = formatWatchLoginToken("SAPISID=fake-session", "fake-visitor", "sync", "0", "Watch", "", "")
+
+    @Test fun `phone export round trips through Windows text file`() {
+        val file = folder.newFile()
+        file.writeText("\uFEFF" + token.replace("\n", "\r\n"))
+        val parsed = checkNotNull(parseWatchLoginToken(readWatchLoginFile(file)))
+        assertEquals("SAPISID=fake-session", parsed.cookie)
+        assertEquals("Watch", parsed.accountName)
+    }
+
+    @Test fun `missing malformed and oversized files are rejected`() {
+        val invalid = folder.newFile()
+        for (text in listOf("not a login", "x".repeat(32_769))) {
+            invalid.writeText(text)
+            assertTrue(runCatching { readWatchLoginFile(invalid) }.isFailure)
+        }
+        assertTrue(runCatching { readWatchLoginFile(File(folder.root, "missing")) }.isFailure)
+    }
+}
