+package com.metrolist.music.utils
+
+import android.app.Application
+import android.content.ContextWrapper
+import androidx.test.core.app.ApplicationProvider
+import org.junit.Assert.*
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import java.io.File
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [36], application = Application::class)
+class CrashReportStorageTest {
+    @Test fun `crash is saved in an app external folder and the latest report replaces the old one`() {
+        val app = ApplicationProvider.getApplicationContext<Application>()
+        val expected = File(app.getExternalFilesDir(null), "crash-reports/latest-crash.txt")
+        val file = CrashHandler.persistCrashLog(app, "first exception")
+        assertEquals(expected, file)
+        assertEquals("first exception", expected.readText())
+        assertEquals(expected, CrashHandler.persistCrashLog(app, "second exception\nCaused by: test"))
+        assertEquals("second exception\nCaused by: test", expected.readText())
+        assertEquals(expected, CrashHandler.savedCrashLog(app))
+    }
+
+    @Test fun `internal storage is used if external app storage is unavailable`() {
+        val app = ApplicationProvider.getApplicationContext<Application>()
+        val context = object : ContextWrapper(app) {
+            override fun getExternalFilesDir(type: String?): File? = null
+        }
+        val expected = File(app.noBackupFilesDir, "crash-reports/latest-crash.txt")
+        assertEquals(expected, CrashHandler.persistCrashLog(context, "exception without external storage"))
+        assertEquals("exception without external storage", expected.readText())
+        assertEquals(expected, CrashHandler.savedCrashLog(context))
+    }
+}
