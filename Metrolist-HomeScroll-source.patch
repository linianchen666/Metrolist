+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34, 36], application = Application::class)
+class WidgetServiceAvailabilityTest {
+    @Test
+    fun `startup and playback updates tolerate a missing widget service`() = runTest {
+        val app = ApplicationProvider.getApplicationContext<Application>()
+        val context = object : ContextWrapper(app) {
+            override fun getSystemService(name: String): Any? =
+                if (name == Context.APPWIDGET_SERVICE) null else super.getSystemService(name)
+        }
+        assertNull(AppWidgetManager.getInstance(context))
+        val internal = Room.inMemoryDatabaseBuilder(app, InternalDatabase::class.java)
+            .allowMainThreadQueries()
+            .build()
+        try {
+            val database = MusicDatabase(internal)
+            val playlists = PlaylistWidgetManager(context, database, backgroundScope)
+            assertFalse(backgroundScope.coroutineContext.job.children.any())
+            playlists.updateIdleWidgets()
+            playlists.updateIdleWidget(1, Bundle())
+            playlists.updateWidgets("Song", "Artist", null, true, false, 1000, 100)
+            playlists.updateProgress(1000, 100)
+            val widgets = MetrolistWidgetManager(context, database, playlists)
+            widgets.updateWidgets("Song", "Artist", null, true, false, 1000, 100)
+            widgets.updateProgress(1000, 100)
+            MusicRecognizerWidgetReceiver().onReceive(
+                context,
+                Intent(MusicRecognizerWidgetReceiver.ACTION_UPDATE_WIDGET),
+            )
+        } finally {
+            internal.close()
+        }
+    }
+
+    @Test
+    fun `devices with widget service still observe changes and accept updates`() = runTest {
+        val context = ApplicationProvider.getApplicationContext<Application>()
+        assertNotNull(AppWidgetManager.getInstance(context))
+        val internal = Room.inMemoryDatabaseBuilder(context, InternalDatabase::class.java)
+            .allowMainThreadQueries()
+            .build()
+        try {
+            val database = MusicDatabase(internal)
+            val playlists = PlaylistWidgetManager(context, database, backgroundScope)
+            assertTrue(backgroundScope.coroutineContext.job.children.any())
+            playlists.updateIdleWidgets()
+            playlists.updateProgress(1000, 100)
+            val widgets = MetrolistWidgetManager(context, database, playlists)
+            widgets.updateWidgets("Song", "Artist", null, true, false, 1000, 100)
+            widgets.updateProgress(1000, 100)
+        } finally {
+            internal.close()
+        }
+    }
+}
