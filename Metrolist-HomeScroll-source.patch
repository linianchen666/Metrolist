+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34, 36], application = App::class, qualifiers = "w192dp-h192dp-round-watch")
+class WatchAppStartupTest {
+    private lateinit var connection: PlayerConnection
+    private val compose = createAndroidComposeRule<MainActivity>()
+    @get:Rule val rules = RuleChain.outerRule(object : ExternalResource() {
+        override fun before() {
+            val app = ApplicationProvider.getApplicationContext<App>()
+            shadowOf(app.packageManager).setSystemFeature(PackageManager.FEATURE_WATCH, true)
+            // Robolectric has no Android service binding; exercise local playback directly.
+            shadowOf(app).declareComponentUnbindable(ComponentName(app, MusicService::class.java))
+            InnerTubeXPlayer.initialize(app)
+        }
+    }).around(compose)
+
+    @Test fun `production watch screen renders and observes the initialized player`() {
+        val service = Robolectric.buildService(MusicService::class.java).create()
+        val host = compose.activity
+        try {
+            compose.runOnUiThread {
+                connection = PlayerConnection(host, service.get().MusicBinder(), host.database, host.lifecycleScope)
+                host.setContent {
+                    MetrolistTheme(darkTheme = true, pureBlack = true) {
+                        WatchApp(connection, host.database, host.downloadUtil)
+                    }
+                }
+            }
+            compose.onNodeWithContentDescription("Home").assertIsDisplayed()
+            compose.runOnIdle { assertTrue(connection.mediaMetadata.subscriptionCount.value > 0) }
+        } finally {
+            compose.runOnUiThread { host.setContent { Text("Finished") } }
+            compose.waitForIdle()
+            compose.runOnUiThread { if (::connection.isInitialized) connection.dispose() }
+            service.destroy()
+        }
+    }
+}
