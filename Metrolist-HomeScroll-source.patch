+package com.metrolist.music.viewmodels
+
+import com.metrolist.innertube.pages.HomePage
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.runBlocking
+import kotlinx.coroutines.test.StandardTestDispatcher
+import kotlinx.coroutines.test.advanceUntilIdle
+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.withTimeout
+import org.junit.Assert.*
+import org.junit.Test
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class HomePageLoaderTest {
+    private fun page(token: String? = "next") = HomePage(null, emptyList(), token)
+
+    @Test fun `rapid scroll callbacks schedule only one background load`() = runTest {
+        val pages = MutableStateFlow<HomePage?>(page())
+        var calls = 0
+        val loader = HomePageLoader(this, pages, StandardTestDispatcher(testScheduler)) {
+            calls++
+            it.copy(continuation = "last")
+        }
+        repeat(20) { loader.load("next") }
+        assertEquals(0, calls)
+        advanceUntilIdle()
+        assertEquals(1, calls)
+        assertEquals("last", pages.value?.continuation)
+        loader.load("last")
+        advanceUntilIdle()
+        assertEquals(2, calls)
+    }
+
+    @Test fun `refresh makes an in flight response obsolete`() = runTest {
+        val response = CompletableDeferred<HomePage?>()
+        val pages = MutableStateFlow<HomePage?>(page())
+        val loader = HomePageLoader(this, pages, StandardTestDispatcher(testScheduler)) { response.await() }
+        loader.load("next")
+        testScheduler.runCurrent()
+        val refreshed = page("refreshed")
+        pages.value = refreshed
+        response.complete(page("old-response"))
+        advanceUntilIdle()
+        assertSame(refreshed, pages.value)
+    }
+
+    @Test fun `failed requests release the gate for retry`() = runTest {
+        val pages = MutableStateFlow<HomePage?>(page())
+        var calls = 0
+        val loader = HomePageLoader(this, pages, StandardTestDispatcher(testScheduler)) {
+            if (++calls == 1) error("offline")
+            it.copy(continuation = null)
+        }
+        loader.load("next")
+        advanceUntilIdle()
+        assertEquals("next", pages.value?.continuation)
+        loader.load("next")
+        advanceUntilIdle()
+        assertEquals(2, calls)
+        assertNull(pages.value?.continuation)
+    }
+
+    @Test fun `null and stale tokens never start requests`() = runTest {
+        val pages = MutableStateFlow<HomePage?>(page())
+        var calls = 0
+        val loader = HomePageLoader(this, pages, StandardTestDispatcher(testScheduler)) { calls++; it }
+        loader.load(null)
+        loader.load("stale")
+        pages.value = null
+        loader.load("next")
+        advanceUntilIdle()
+        assertEquals(0, calls)
+    }
+
+    @Test fun `empty responses also release the gate`() = runTest {
+        var calls = 0
+        val loader = HomePageLoader(this, MutableStateFlow(page()), StandardTestDispatcher(testScheduler)) { calls++; null }
+        repeat(2) { loader.load("next"); advanceUntilIdle() }
+        assertEquals(2, calls)
+    }
+
+    @Test fun `production dispatcher runs loading away from the caller thread`() = runBlocking {
+        val caller = Thread.currentThread().id
+        val worker = CompletableDeferred<Long>()
+        val loader = HomePageLoader(this, MutableStateFlow(page())) { worker.complete(Thread.currentThread().id); null }
+        loader.load("next")
+        assertNotEquals(caller, withTimeout(5_000) { worker.await() })
+    }
+}
