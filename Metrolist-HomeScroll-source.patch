+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [36], application = Application::class)
+class HomeCardQueryTest {
+    @get:Rule val compose = createComposeRule()
+
+    @Test fun `card updates retain the existing database subscription`() {
+        val queries = AtomicInteger()
+        val direct = Executor { it.run() }
+        val database = Room.inMemoryDatabaseBuilder(ApplicationProvider.getApplicationContext(), InternalDatabase::class.java)
+            .allowMainThreadQueries()
+            .setQueryExecutor(direct)
+            .setQueryCallback({ sql, _ ->
+                if (sql.startsWith("SELECT", ignoreCase = true) && sql.contains("browseId")) queries.incrementAndGet()
+            }, direct)
+            .build()
+        val item = mutableStateOf(CommunityPlaylistItem(
+            PlaylistItem("PLtest", "Initial", null, null, null, null, null, null), emptyList(),
+        ))
+        try {
+            val musicDatabase = MusicDatabase(database)
+            compose.setContent {
+                MaterialTheme {
+                    CompositionLocalProvider(LocalDatabase provides musicDatabase, LocalPlayerConnection provides null) {
+                        CommunityPlaylistCard(item.value, onClick = {}, onSongClick = {})
+                    }
+                }
+            }
+            compose.waitUntil(5_000) { queries.get() > 0 }
+            compose.waitForIdle()
+            val initial = queries.get()
+            repeat(5) { index ->
+                compose.runOnIdle { item.value = item.value.copy(playlist = item.value.playlist.copy(title = "Title $index")) }
+                compose.waitForIdle()
+            }
+            assertEquals(initial, queries.get())
+        } finally {
+            database.close()
+        }
+    }
+}
