+package com.metrolist.music.ui.screens.watch
+
+import androidx.media3.exoplayer.offline.Download
+import com.metrolist.innertube.models.PlaylistItem
+import com.metrolist.music.models.MediaMetadata
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.NonCancellable
+import kotlinx.coroutines.test.StandardTestDispatcher
+import kotlinx.coroutines.test.advanceUntilIdle
+import kotlinx.coroutines.test.resetMain
+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.test.setMain
+import kotlinx.coroutines.withContext
+import org.junit.After
+import org.junit.Assert.*
+import org.junit.Before
+import org.junit.Test
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class WatchLibraryViewModelTest {
+    private val dispatcher = StandardTestDispatcher()
+    @Before fun setUp() { Dispatchers.setMain(dispatcher) }
+    @After fun tearDown() { Dispatchers.resetMain() }
+    private fun playlist(id: String) = PlaylistItem(id, id, null, null, null, null, null, null)
+    private fun song(id: String) = MediaMetadata(id, id, emptyList(), 100)
+
+    @Test fun `account library preserves server order and retries without losing playlists`() = runTest(dispatcher) {
+        var fail = false
+        val model = WatchLibraryViewModel(loadPlaylists = {
+            if (fail) Result.failure(IllegalStateException("offline"))
+            else Result.success(listOf(playlist("b"), playlist("a"), playlist("b")))
+        })
+        model.refresh()
+        advanceUntilIdle()
+        assertEquals(listOf("b", "a"), model.state.playlists.map { it.id })
+        assertTrue(model.state.loaded)
+        fail = true
+        model.refresh()
+        advanceUntilIdle()
+        assertTrue(model.state.failed)
+        assertEquals(2, model.state.playlists.size)
+        fail = false
+        model.refresh()
+        advanceUntilIdle()
+        assertFalse(model.state.failed)
+    }
+
+    @Test fun `complete playlist exposes every track for playback and batch download`() = runTest(dispatcher) {
+        val songs = (1..151).map { song("song-$it") }
+        val model = WatchLibraryViewModel(loadSongs = { Result.success(songs + songs.first()) })
+        model.open(playlist("saved"))
+        assertTrue(model.state.songsLoading)
+        advanceUntilIdle()
+        assertEquals(songs, model.state.songs)
+        assertEquals(songs, watchDownloadCandidates(model.state.songs, emptyMap()))
+    }
+
+    @Test fun `failed playlist load clears previous songs until a successful retry`() = runTest(dispatcher) {
+        var fail = false
+        val model = WatchLibraryViewModel(loadSongs = {
+            if (fail) Result.failure(IllegalStateException("page failed")) else Result.success(listOf(song(it)))
+        })
+        model.open(playlist("first"))
+        advanceUntilIdle()
+        fail = true
+        model.open(playlist("second"))
+        advanceUntilIdle()
+        assertTrue(model.state.songsFailed)
+        assertTrue(model.state.songs.isEmpty())
+        fail = false
+        model.open(model.state.selected!!)
+        advanceUntilIdle()
+        assertEquals(listOf("second"), model.state.songs.map { it.id })
+    }
+
+    @Test fun `switching playlists rejects late old responses`() = runTest(dispatcher) {
+        val late = CompletableDeferred<Result<List<MediaMetadata>>>()
+        val model = WatchLibraryViewModel(loadSongs = {
+            if (it == "old") withContext(NonCancellable) { late.await() }
+            else Result.success(listOf(song(it)))
+        })
+        model.open(playlist("old"))
+        testScheduler.runCurrent()
+        model.open(playlist("new"))
+        testScheduler.runCurrent()
+        late.complete(Result.success(listOf(song("old"))))
+        advanceUntilIdle()
+        assertEquals("new", model.state.selected?.id)
+        assertEquals(listOf("new"), model.state.songs.map { it.id })
+    }
+
+    @Test fun `changing account clears library and rejects stale responses`() = runTest(dispatcher) {
+        val late = CompletableDeferred<Result<List<PlaylistItem>>>()
+        val model = WatchLibraryViewModel(loadPlaylists = { withContext(NonCancellable) { late.await() } })
+        model.refresh()
+        testScheduler.runCurrent()
+        model.reset()
+        late.complete(Result.success(listOf(playlist("old-account"))))
+        advanceUntilIdle()
+        assertEquals(WatchLibraryState(), model.state)
+    }
+
+    @Test fun `liked music opens the account liked songs playlist`() = runTest(dispatcher) {
+        var requested = ""
+        val model = WatchLibraryViewModel(loadSongs = { requested = it; Result.success(listOf(song("liked"))) })
+        model.open(playlist("LM"))
+        advanceUntilIdle()
+        assertEquals("LM", requested)
+        assertEquals("liked", model.state.songs.single().id)
+    }
+
+    @Test fun `downloads skip completed and active tracks but retry failures and stopped tracks`() {
+        val states = mapOf("done" to Download.STATE_COMPLETED, "active" to Download.STATE_DOWNLOADING,
+            "queued" to Download.STATE_QUEUED, "restart" to Download.STATE_RESTARTING,
+            "removing" to Download.STATE_REMOVING, "failed" to Download.STATE_FAILED, "stopped" to Download.STATE_STOPPED)
+        val songs = (states.keys + "new").map(::song) + song("new")
+        assertEquals(listOf("failed", "stopped", "new"), watchDownloadCandidates(songs, states).map { it.id })
+    }
+}
