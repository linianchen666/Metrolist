+package com.metrolist.music.ui.screens.watch
+
+import android.content.Context
+import java.io.File
+
+internal const val WATCH_LOGIN_FILE_NAME = "Metrolist-login.txt"
+
+internal fun watchLoginFile(context: Context): File? =
+    context.getExternalFilesDir(null)?.let { File(it, WATCH_LOGIN_FILE_NAME) }
+
+internal fun readWatchLoginFile(file: File): String {
+    val bytes = file.inputStream().use { input ->
+        val buffer = ByteArray(32_769)
+        var size = 0
+        while (size < buffer.size) {
+            val count = input.read(buffer, size, buffer.size - size)
+            if (count < 0) break
+            size += count
+        }
+        buffer.copyOf(size)
+    }
+    require(bytes.size <= 32_768)
+    val text = bytes.toString(Charsets.UTF_8).removePrefix("\uFEFF").replace("\r\n", "\n")
+    require(parseWatchLoginToken(text) != null)
+    return text
+}
+
+internal fun formatWatchLoginToken(
+    cookie: String, visitorData: String, dataSyncId: String, authUser: String,
+    accountName: String, accountEmail: String, accountChannelHandle: String,
+): String = """
+    ***INNERTUBE COOKIE*** =$cookie
+    ***VISITOR DATA*** =$visitorData
+    ***DATASYNC ID*** =$dataSyncId
+    ***AUTH USER*** =$authUser
+    ***ACCOUNT NAME*** =$accountName
+    ***ACCOUNT EMAIL*** =$accountEmail
+    ***ACCOUNT CHANNEL HANDLE*** =$accountChannelHandle
+""".trimIndent()
