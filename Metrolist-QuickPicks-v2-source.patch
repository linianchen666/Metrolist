+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [33], application = Application::class)
+@OptIn(ExperimentalCoroutinesApi::class)
+class WatchAccountViewModelTest {
+    private val dispatcher = StandardTestDispatcher()
+    @Before fun setUp() { Dispatchers.setMain(dispatcher) }
+    @After fun tearDown() {
+        Dispatchers.resetMain()
+        YouTube.cookie = null
+        YouTube.visitorData = null
+        YouTube.dataSyncId = null
+        YouTube.authUser = "0"
+    }
+
+    @Test fun `watch persists its selected account and logout preserves unrelated preferences`() = runTest(dispatcher) {
+        val app = ApplicationProvider.getApplicationContext<Application>()
+        val localKey = stringPreferencesKey("watch-local-test")
+        app.safeDataStoreEdit { it[localKey] = "keep" }
+        val model = WatchAccountViewModel(app)
+        val imported = CompletableDeferred<Unit>()
+        model.signIn("***INNERTUBE COOKIE*** =SAPISID=test-session\n***VISITOR DATA*** =test-visitor\n***ACCOUNT NAME*** =Watch account") {
+            imported.complete(Unit)
+        }
+        imported.await()
+        val saved = app.dataStore.data.first()
+        assertEquals("SAPISID=test-session", saved[InnerTubeCookieKey])
+        assertEquals("Watch account", saved[AccountNameKey])
+        assertEquals(true, saved[UseLoginForBrowse])
+        assertEquals("SAPISID=test-session", YouTube.cookie)
+        val removed = CompletableDeferred<Unit>()
+        model.signOut { removed.complete(Unit) }
+        removed.await()
+        val signedOut = app.dataStore.data.first()
+        assertNull(signedOut[InnerTubeCookieKey])
+        assertNull(YouTube.cookie)
+        assertEquals("keep", signedOut[localKey])
+    }
+}
