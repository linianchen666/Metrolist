+                            CircularProgressIndicator(Modifier.size(24.dp))
+                        }
+                    }
+                } else {
+                    if (recommendations.failed || recommendations.songs.isEmpty()) {
+                        item {
+                            Text(stringResource(if (recommendations.failed) R.string.youtube_quick_picks_failed else R.string.youtube_quick_picks_empty), textAlign = TextAlign.Center)
+                        }
+                    }
+                    if (!signedIn) {
+                        item { WatchButton(stringResource(R.string.login), onClick = { page = "account" }) }
+                    }
+                    item {
+                        WatchButton(
+                            stringResource(if (recommendations.failed) R.string.retry else R.string.watch_refresh_recommendations),
+                            onClick = onRefreshRecommendations,
+                        )
+                    }
+                }
+            }
+            "search" -> {
+                item {
+                    OutlinedTextField(
+                        value = query, onValueChange = { query = it },
+                        modifier = Modifier.fillMaxWidth(), singleLine = true,
+                        label = { Text(stringResource(R.string.search)) },
+                        keyboardOptions = KeyboardOptions(imeAction = ImeAction.Search),
+                        keyboardActions = KeyboardActions(onSearch = { focus.clearFocus(); onSearch(query) }),
+                    )
+                }
+                item {
+                    WatchButton(stringResource(R.string.search), query.isNotBlank()) {
+                        focus.clearFocus()
+                        onSearch(query)
+                    }
+                }
+                val songs = search.songs.map { it.toMediaMetadata() }
+                songRows(songs, ready) { index -> onPlay(songs, index); page = "player" }
+                if (search.loading) {
+                    item { Box(Modifier.fillMaxWidth(), contentAlignment = Alignment.Center) { CircularProgressIndicator(Modifier.size(24.dp)) } }
+                } else if (search.failed) {
+                    item { Text(stringResource(R.string.watch_search_failed), textAlign = TextAlign.Center) }
+                    item { WatchButton(stringResource(R.string.retry), onClick = onRetry) }
+                } else if (search.query.isNotEmpty() && songs.isEmpty()) {
+                    item { Text(stringResource(R.string.no_results_found), textAlign = TextAlign.Center) }
+                }
+                if (!search.loading && !search.failed && search.continuation != null) {
+                    item { WatchButton(stringResource(R.string.watch_load_more), onClick = onLoadMore) }
+                }
+            }
+            else -> {
+                val songs = if (page == "downloads") downloads else library
+                item { Text(stringResource(if (page == "downloads") R.string.downloaded_songs else R.string.watch_library), textAlign = TextAlign.Center) }
+                if (songs.isEmpty()) {
+                    item { Text(stringResource(R.string.library_song_empty), textAlign = TextAlign.Center) }
+                }
+                songRows(songs, ready) { index -> onPlay(songs, index); page = "player" }
+            }
+        }
+    }
+}
+
+private fun findWatchActivity(context: Context): Activity? {
+    var current = context
+    while (current is ContextWrapper) {
+        if (current is Activity) return current
+        current = current.baseContext
+    }
+    return null
+}
+
+@Composable
+private fun WatchList(page: String, content: LazyListScope.() -> Unit) {
+    val state = rememberLazyListState()
+    val focus = remember { FocusRequester() }
+    val scope = rememberCoroutineScope()
+    LaunchedEffect(page) { state.scrollToItem(0); focus.requestFocus() }
+    Surface(Modifier.fillMaxSize(), color = Color.Black, contentColor = Color.White) {
+        LazyColumn(
+            state = state,
+            modifier = Modifier.fillMaxSize().focusRequester(focus)
+                .onRotaryScrollEvent { event ->
+                    scope.launch { state.scrollBy(event.verticalScrollPixels) }
+                    true
+                }
+                .focusable(),
+            contentPadding = PaddingValues(horizontal = 24.dp, vertical = 32.dp),
+            verticalArrangement = Arrangement.spacedBy(8.dp),
+            horizontalAlignment = Alignment.CenterHorizontally,
+            content = content,
+        )
+    }
+}
+
+@Composable
+private fun WatchButton(text: String, enabled: Boolean = true, onClick: () -> Unit) {
+    Button(onClick = onClick, enabled = enabled, modifier = Modifier.fillMaxWidth().heightIn(min = 48.dp),
+        contentPadding = PaddingValues(horizontal = 8.dp, vertical = 8.dp)) {
+        Text(text, textAlign = TextAlign.Center, maxLines = 2, overflow = TextOverflow.Ellipsis)
+    }
+}
+
+@Composable
+private fun WatchControl(@DrawableRes icon: Int, label: String, enabled: Boolean = true, onClick: () -> Unit, prominent: Boolean = false) {
+    IconButton(onClick = onClick, enabled = enabled,
+        modifier = Modifier.size(48.dp).background(if (prominent) MaterialTheme.colorScheme.primaryContainer else Color.Transparent, CircleShape)) {
+        Icon(
+            painterResource(icon), label, Modifier.size(26.dp),
+            tint = if (prominent) MaterialTheme.colorScheme.onPrimaryContainer else LocalContentColor.current,
+        )
+    }
+}
+
+private fun LazyListScope.songRows(songs: List<MediaMetadata>, enabled: Boolean, onClick: (Int) -> Unit) {
+    itemsIndexed(songs, key = { _, song -> song.id }) { index, song ->
+        Column(
+            Modifier.fillMaxWidth().clip(RoundedCornerShape(20.dp))
+                .background(MaterialTheme.colorScheme.surfaceContainer)
+                .clickable(enabled = enabled) { onClick(index) }
+                .padding(horizontal = 12.dp, vertical = 10.dp).heightIn(min = 36.dp),
+            verticalArrangement = Arrangement.Center,
+        ) {
+            Text(song.title, style = MaterialTheme.typography.bodyMedium, maxLines = 2, overflow = TextOverflow.Ellipsis)
+            Text(song.artists.joinToString { it.name }, style = MaterialTheme.typography.bodySmall,
+                maxLines = 1, overflow = TextOverflow.Ellipsis, color = MaterialTheme.colorScheme.onSurfaceVariant)
+        }
+    }
+}
