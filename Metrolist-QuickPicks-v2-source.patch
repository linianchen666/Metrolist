+    recommendations: WatchRecommendationsState,
+    onRefreshRecommendations: () -> Unit,
+    onSearch: (String) -> Unit,
+    onLoadMore: () -> Unit,
+    onRetry: () -> Unit,
+    onPlay: (List<MediaMetadata>, Int) -> Unit,
+    onTogglePlayback: () -> Unit,
+    onPrevious: () -> Unit,
+    onNext: () -> Unit,
+    onSave: () -> Unit,
+    onDownload: () -> Unit,
+    accountName: String = "",
+    signedIn: Boolean = false,
