+        val alreadySecure = window?.attributes?.flags?.and(WindowManager.LayoutParams.FLAG_SECURE) != 0
+        if (accountPage) window?.addFlags(WindowManager.LayoutParams.FLAG_SECURE)
+        onDispose {
+            if (accountPage && !alreadySecure) window?.clearFlags(WindowManager.LayoutParams.FLAG_SECURE)
+        }
+    }
+    BackHandler(page != "player") { page = "player" }
+    WatchList(page) {
+        if (page != "player") {
