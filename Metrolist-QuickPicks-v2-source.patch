+import com.metrolist.music.constants.DataSyncIdKey
+import com.metrolist.music.constants.InnerTubeAuthUserKey
+import com.metrolist.music.constants.InnerTubeCookieKey
+import com.metrolist.music.constants.UseLoginForBrowse
+import com.metrolist.music.constants.VisitorDataKey
+import com.metrolist.music.utils.safeDataStoreEdit
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.launch
+
+internal class WatchLoginToken(
+    val cookie: String,
+    val visitorData: String,
+    val dataSyncId: String,
+    val authUser: String,
+    val accountName: String,
+    val accountEmail: String,
+    val accountChannelHandle: String,
+)
+
+internal fun parseWatchLoginToken(text: String): WatchLoginToken? {
+    if (text.length > 32_768 || text.any { it == '\u0000' || it == '\r' }) return null
+    val fields = mutableMapOf<String, String>()
+    for (line in text.lineSequence().map { it.trim() }.filter { it.isNotEmpty() }) {
+        val parts = line.split(" =", limit = 2)
+        if (parts.size != 2 || fields.put(parts[0], parts[1].trim()) != null) return null
+    }
+    val cookie = fields["***INNERTUBE COOKIE***"].orEmpty()
+    val visitor = fields["***VISITOR DATA***"].orEmpty()
+    val authUser = fields["***AUTH USER***"] ?: "0"
+    if (parseCookieString(cookie)["SAPISID"].isNullOrBlank() || visitor.isBlank() || !authUser.matches(Regex("[0-9]{1,3}"))) return null
+    return WatchLoginToken(
+        cookie, visitor, fields["***DATASYNC ID***"].orEmpty(), authUser,
+        fields["***ACCOUNT NAME***"].orEmpty(), fields["***ACCOUNT EMAIL***"].orEmpty(),
+        fields["***ACCOUNT CHANNEL HANDLE***"].orEmpty(),
+    )
+}
+
+internal class WatchAccountViewModel(application: Application) : AndroidViewModel(application) {
+    var busy by mutableStateOf(false)
+        private set
+    var failed by mutableStateOf(false)
+        private set
+
+    fun signIn(text: String, onComplete: () -> Unit) {
+        val token = parseWatchLoginToken(text)
+        if (token == null) { failed = true; return }
+        if (busy) return
+        busy = true
+        failed = false
+        viewModelScope.launch {
+            try {
+                val saved = getApplication<Application>().safeDataStoreEdit { settings ->
+                    settings[InnerTubeCookieKey] = token.cookie
+                    settings[VisitorDataKey] = token.visitorData
+                    settings[DataSyncIdKey] = token.dataSyncId
+                    settings[InnerTubeAuthUserKey] = token.authUser
+                    settings[AccountNameKey] = token.accountName
+                    settings[AccountEmailKey] = token.accountEmail
+                    settings[AccountChannelHandleKey] = token.accountChannelHandle
+                    settings[UseLoginForBrowse] = true
+                }
+                check(saved)
+                YouTube.cookie = token.cookie
+                YouTube.visitorData = token.visitorData
+                YouTube.dataSyncId = token.dataSyncId
+                YouTube.authUser = token.authUser
+                YouTube.useLoginForBrowse = true
+                onComplete()
+            } catch (error: CancellationException) {
+                throw error
+            } catch (_: Exception) {
+                failed = true
+            } finally {
+                busy = false
+            }
+        }
+    }
+
+    fun signOut(onComplete: () -> Unit) {
+        if (busy) return
+        busy = true
+        failed = false
+        viewModelScope.launch {
+            try {
+                check(getApplication<Application>().safeDataStoreEdit { settings ->
+                    settings.remove(InnerTubeCookieKey)
+                    settings.remove(VisitorDataKey)
+                    settings.remove(DataSyncIdKey)
+                    settings.remove(InnerTubeAuthUserKey)
+                    settings.remove(AccountNameKey)
+                    settings.remove(AccountEmailKey)
+                    settings.remove(AccountChannelHandleKey)
+                })
+                YouTube.cookie = null
+                YouTube.visitorData = null
+                YouTube.dataSyncId = null
+                YouTube.authUser = "0"
+                onComplete()
+            } catch (error: CancellationException) {
+                throw error
+            } catch (_: Exception) {
+                failed = true
+            } finally {
+                busy = false
+            }
+        }
+    }
+}
