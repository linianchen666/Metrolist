+package com.metrolist.music.ui.screens.watch
+
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.setValue
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import com.metrolist.innertube.YouTube
+import com.metrolist.innertube.pages.HomePage
+import com.metrolist.music.models.MediaMetadata
+import com.metrolist.music.models.toMediaMetadata
+import com.metrolist.music.viewmodels.youtubeQuickPicks
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.launch
+
+internal data class WatchRecommendationsState(
+    val songs: List<MediaMetadata> = emptyList(),
+    val loading: Boolean = false,
+    val failed: Boolean = false,
+)
+
+internal class WatchRecommendationsViewModel(
+    private val loadHome: suspend () -> Result<HomePage> = { YouTube.home() },
+) : ViewModel() {
+    var state by mutableStateOf(WatchRecommendationsState())
+        private set
+    private var request: Job? = null
+
+    fun reset() {
+        request?.cancel()
+        state = WatchRecommendationsState()
+    }
+
+    fun refresh(localizedTitle: String) {
+        if (state.loading) return
+        state = state.copy(loading = true, failed = false)
+        request = viewModelScope.launch {
+            val result = loadHome()
+            currentCoroutineContext().ensureActive()
+            result.fold(
+                onSuccess = { page ->
+                    state = WatchRecommendationsState(youtubeQuickPicks(page, localizedTitle).map { it.toMediaMetadata() })
+                },
+                onFailure = { error ->
+                    if (error is CancellationException) throw error
+                    state = state.copy(loading = false, failed = true)
+                },
+            )
+        }
+    }
+}
