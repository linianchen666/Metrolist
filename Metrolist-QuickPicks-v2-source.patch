+package com.metrolist.music.ui.screens.watch
+
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.setValue
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import com.metrolist.innertube.YouTube
+import com.metrolist.innertube.models.SongItem
+import com.metrolist.innertube.pages.SearchResult
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.launch
+
+internal data class WatchSearchState(
+    val query: String = "",
+    val songs: List<SongItem> = emptyList(),
+    val continuation: String? = null,
+    val loading: Boolean = false,
+    val failed: Boolean = false,
+)
+
+internal class WatchSearchViewModel(
+    private val searchSongs: suspend (String) -> Result<SearchResult> = {
+        YouTube.search(it, YouTube.SearchFilter.FILTER_SONG)
+    },
+    private val nextPage: suspend (String) -> Result<SearchResult> = {
+        YouTube.searchContinuation(it)
+    },
+) : ViewModel() {
+    var state by mutableStateOf(WatchSearchState())
+        private set
+    private var request: Job? = null
+
+    fun search(query: String) {
+        request?.cancel()
+        val trimmed = query.trim()
+        state = WatchSearchState(query = trimmed, loading = trimmed.isNotEmpty())
+        if (trimmed.isEmpty()) return
+        request = viewModelScope.launch { complete(searchSongs(trimmed)) }
+    }
+
+    fun loadMore() {
+        val continuation = state.continuation ?: return
+        if (state.loading) return
+        state = state.copy(loading = true, failed = false)
+        request = viewModelScope.launch { complete(nextPage(continuation)) }
+    }
+
+    private suspend fun complete(result: Result<SearchResult>) {
+        currentCoroutineContext().ensureActive()
+        result.fold(
+            onSuccess = { page ->
+                state = state.copy(
+                    songs = (state.songs + page.items.filterIsInstance<SongItem>()).distinctBy { it.id },
+                    continuation = page.continuation,
+                    loading = false,
+                    failed = false,
+                )
+            },
+            onFailure = { error ->
+                if (error is CancellationException) throw error
+                state = state.copy(loading = false, failed = true)
+            },
+        )
+    }
+
+    fun retry() {
+        if (state.continuation != null) loadMore() else search(state.query)
+    }
+}
