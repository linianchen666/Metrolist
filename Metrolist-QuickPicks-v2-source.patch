+package com.metrolist.music.viewmodels
+
+import com.metrolist.innertube.models.SongItem
+import com.metrolist.innertube.pages.HomePage
+
+internal fun youtubeQuickPicksSection(page: HomePage?, localizedTitle: String): HomePage.Section? {
+    // Shelf titles follow the YouTube content language, which may differ from the app language.
+    val titles = setOf(localizedTitle, "Quick picks", "猜你喜欢", "猜你喜歡", "歌曲快選", "快速選曲")
+    return page?.sections?.firstOrNull { section -> titles.any { it.equals(section.title.trim(), ignoreCase = true) } }
+}
+
+internal fun youtubeQuickPicks(page: HomePage?, localizedTitle: String): List<SongItem> =
+    youtubeQuickPicksSection(page, localizedTitle)?.items.orEmpty()
+        .filterIsInstance<SongItem>()
+        .distinctBy { it.id }
