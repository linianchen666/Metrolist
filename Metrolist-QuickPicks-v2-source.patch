+package com.metrolist.music.ui.screens.watch
+
+import com.metrolist.innertube.models.SongItem
+import com.metrolist.innertube.pages.SearchResult
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.NonCancellable
+import kotlinx.coroutines.test.StandardTestDispatcher
+import kotlinx.coroutines.test.advanceUntilIdle
+import kotlinx.coroutines.test.resetMain
+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.test.setMain
+import kotlinx.coroutines.withContext
+import org.junit.After
+import org.junit.Assert.*
+import org.junit.Before
+import org.junit.Test
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class WatchSearchViewModelTest {
+    private val dispatcher = StandardTestDispatcher()
+
+    @Before fun setUp() { Dispatchers.setMain(dispatcher) }
+    @After fun tearDown() { Dispatchers.resetMain() }
+
+    private fun song(id: String) = SongItem(id, id, emptyList(), thumbnail = "")
+
+    @Test fun `blank searches do not access the network`() = runTest(dispatcher) {
+        var calls = 0
+        val model = WatchSearchViewModel(searchSongs = { calls++; Result.success(SearchResult(emptyList())) })
+        model.search("   ")
+        advanceUntilIdle()
+        assertEquals(0, calls)
+        assertFalse(model.state.loading)
+    }
+
+    @Test fun `pagination preserves songs and retries a failed page without duplicates`() = runTest(dispatcher) {
+        var fail = true
+        val model = WatchSearchViewModel(
+            searchSongs = { Result.success(SearchResult(listOf(song("one")), "next")) },
+            nextPage = {
+                assertEquals("next", it)
+                if (fail) Result.failure(IllegalStateException("offline"))
+                else Result.success(SearchResult(listOf(song("one"), song("two"))))
+            },
+        )
+        model.search(" song ")
+        advanceUntilIdle()
+        assertEquals("song", model.state.query)
+        model.loadMore()
+        advanceUntilIdle()
+        assertTrue(model.state.failed)
+        assertEquals(listOf("one"), model.state.songs.map { it.id })
+        fail = false
+        model.retry()
+        advanceUntilIdle()
+        assertEquals(listOf("one", "two"), model.state.songs.map { it.id })
+        assertNull(model.state.continuation)
+        assertFalse(model.state.failed)
+    }
+
+    @Test fun `a late response cannot replace a newer search`() = runTest(dispatcher) {
+        val oldResponse = CompletableDeferred<Result<SearchResult>>()
+        val model = WatchSearchViewModel(searchSongs = { query ->
+            if (query == "old") withContext(NonCancellable) { oldResponse.await() }
+            else Result.success(SearchResult(listOf(song("new"))))
+        })
+        model.search("old")
+        testScheduler.runCurrent()
+        model.search("new")
+        testScheduler.runCurrent()
+        oldResponse.complete(Result.success(SearchResult(listOf(song("old")))))
+        advanceUntilIdle()
+        assertEquals(listOf("new"), model.state.songs.map { it.id })
+        assertEquals("new", model.state.query)
+    }
+}
