+package com.metrolist.music.ui.screens.watch
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class WatchLoginTokenTest {
+    private val text = """
+        ***INNERTUBE COOKIE*** =SAPISID=test-session; OTHER=embedded=value
+        ***VISITOR DATA*** =test-visitor
+        ***DATASYNC ID*** =test-channel
+        ***AUTH USER*** =1
+        ***ACCOUNT NAME*** =Watch account
+    """.trimIndent()
+
+    @Test fun `imports existing Metrolist token format without losing equals signs`() {
+        val token = parseWatchLoginToken(text)!!
+        assertEquals("SAPISID=test-session; OTHER=embedded=value", token.cookie)
+        assertEquals("test-visitor", token.visitorData)
+        assertEquals("test-channel", token.dataSyncId)
+        assertEquals("1", token.authUser)
+        assertEquals("Watch account", token.accountName)
+        assertFalse(token.toString().contains("test-session"))
+    }
+
+    @Test fun `rejects malformed credentials and ambiguous duplicate fields`() {
+        assertNull(parseWatchLoginToken(""))
+        assertNull(parseWatchLoginToken(text.replace("SAPISID=test-session", "OTHER=test")))
+        assertNull(parseWatchLoginToken(text.replace("test-visitor", "")))
+        assertNull(parseWatchLoginToken(text.replace("***AUTH USER*** =1", "***AUTH USER*** =not-a-number")))
+        assertNull(parseWatchLoginToken(text + "\n***INNERTUBE COOKIE*** =SAPISID=duplicate"))
+        assertNull(parseWatchLoginToken(text + "\u0000"))
+        assertNull(parseWatchLoginToken("x".repeat(32_769)))
+    }
+}
