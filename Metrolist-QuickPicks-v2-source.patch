+import org.junit.Assert.*
+import org.junit.Before
+import org.junit.Test
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class WatchRecommendationsViewModelTest {
+    private val dispatcher = StandardTestDispatcher()
+    @Before fun setUp() { Dispatchers.setMain(dispatcher) }
+    @After fun tearDown() { Dispatchers.resetMain() }
+
+    @Test fun `watch uses official list and preserves it when refreshing offline`() = runTest(dispatcher) {
+        val song = SongItem("official", "Official recommendation", emptyList(), thumbnail = "cover")
+        var result = Result.success(HomePage(null, listOf(HomePage.Section("猜你喜欢", null, null, null, listOf(song)))))
+        var calls = 0
+        val model = WatchRecommendationsViewModel { calls++; result }
+        model.refresh("Quick picks")
+        model.refresh("Quick picks")
+        advanceUntilIdle()
+        assertEquals(1, calls)
+        assertEquals(listOf("official"), model.state.songs.map { it.id })
+        result = Result.failure(IllegalStateException("offline"))
+        model.refresh("Quick picks")
+        advanceUntilIdle()
+        assertTrue(model.state.failed)
+        assertFalse(model.state.loading)
+        assertEquals(listOf("official"), model.state.songs.map { it.id })
+        result = Result.success(HomePage(null, emptyList()))
+        model.refresh("Quick picks")
+        advanceUntilIdle()
+        assertTrue(model.state.songs.isEmpty())
+        assertFalse(model.state.failed)
+    }
+
+    @Test fun `account change discards a late response from the previous account`() = runTest(dispatcher) {
+        val response = CompletableDeferred<Result<HomePage>>()
+        val model = WatchRecommendationsViewModel { withContext(NonCancellable) { response.await() } }
+        model.refresh("Quick picks")
+        testScheduler.runCurrent()
+        model.reset()
+        val old = SongItem("old-account", "Previous account", emptyList(), thumbnail = "cover")
+        response.complete(Result.success(HomePage(null, listOf(HomePage.Section("Quick picks", null, null, null, listOf(old))))))
+        advanceUntilIdle()
+        assertTrue(model.state.songs.isEmpty())
+        assertFalse(model.state.loading)
+    }
